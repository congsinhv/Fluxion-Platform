# Local database (Docker postgres)
DATABASE_URL=postgresql+psycopg://fluxion:fluxion@localhost:5432/fluxion

# AWS
AWS_PROFILE=fluxion-dev
AWS_REGION=ap-southeast-1
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=ap-southeast-1

# Cognito (filled after first cdk deploy)
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# AppSync / API Gateway (filled after first cdk deploy)
APPSYNC_URL=
APIGW_URL=

# SQS
ACTION_DISPATCH_QUEUE_URL=

# Secrets Manager names
FIREBASE_SECRET_NAME=fluxion/firebase-service-account
DPC_SHARED_KEY_SECRET_NAME=fluxion/dpc-shared-api-key
